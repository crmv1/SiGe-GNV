# ============================================================
#  mobile/.env.example
#  Copia a `.env` y completa. Variables publicas de la app.
#
#  IMPORTANTE: en el celular fisico NO usar "localhost": el
#  localhost del telefono es el propio telefono. Usar la IP
#  del PC en la misma red wifi, ejemplo:
#     EXPO_PUBLIC_API_URL=http://192.168.1.50:3100/api
# ============================================================

# URL base del backend (sin barra final).
EXPO_PUBLIC_API_URL=http://localhost:3100/api

# true = la app usa datos de ejemplo y no llama al servidor.
# false = la app llama al backend real.
EXPO_PUBLIC_USE_MOCK_DATA=false