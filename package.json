{
  "name": "sige-gnv-vc-gas-api",
  "version": "1.0.0",
  "private": true,
  "description": "API Node.js/Express para SIGE-GNV VC GAS. MariaDB como base de datos principal.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
