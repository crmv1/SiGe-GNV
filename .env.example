# ============================================================
#  SIGE-GNV VC GAS — Variables de entorno
#  Copiar este archivo a .env y completar los valores.
#  NO subir .env al repositorio.
# ============================================================

# ----- Servidor -------------------------------------------
PORT=3100
NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma.
# Desarrollo:  http://localhost:5173
# Producción:  https://tu-dominio.com
CORS_ORIGINS=http://localhost:5173

# Clave que usa WPConnect (local en el taller) para llamar a la API.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_INTEGRATION_API_KEY=cambiar_por_clave_aleatoria

# ----- Base de datos MariaDB ------------------------------
# Funciona igual con MariaDB local, en Docker o en cualquier
# proveedor MariaDB online. Solo cambian estos valores.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gnv_taller

# Conexión cifrada. Poner true cuando el proveedor online lo exija.
# false solo para desarrollo local.
DB_SSL=false

# Si DB_SSL=true, indicar la CA. Solo una de las dos opciones:
#   DB_SSL_CA_PATH  -> ruta a un archivo .pem
#   DB_SSL_CA       -> contenido del certificado
# Si se dejan ambas vacías se usa el certificado del sistema.
# DB_SSL_CA_PATH=C:/ruta/al/ca.pem
# DB_SSL_CA=

# ----- Autenticación --------------------------------------
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar_por_secreto_aleatorio
JWT_EXPIRES_IN=8h

# ----- Tarea programada de recordatorios -------------------
# Zona horaria del taller. Define el calculo de los avisos de
# 30, 15 y 7 dias antes de inspeccion y recalificacion.
TZ_TALLER=America/La_Paz

# Minutos entre ejecuciones del job que genera notificaciones.
CRON_RECORDATORIOS=*/30 * * * *

# ----- Modulo de reconocimiento de vehiculos (IA) ----------
# false hasta que entregues el repositorio/modelo definitivo.
AI_VEHICLE_RECOGNITION_ENABLED=false

# Clave de `parametros_precios` donde esta la mano de obra de
# instalacion que usa la estimacion de la IA.
#
# NO se escribe el precio aqui: va en la base, en la tabla
# `parametros_precios`. Cambiar un precio es editar la fila, no
# editar el codigo ni redesplegar.
#
# Esta variable solo cambia QUE clave se consulta. El taller
# normalmente deja el valor por defecto.
# AI_PRECIO_INSTALACION_CLAVE=instalacion_gnv
