# ============================================================
#  whatsapp/.env.example
#  Copiar a whatsapp/.env y completar.
#  NO subir el archivo .env al repositorio.
# ============================================================

# URL de la API Node.js/Express.
# Local:      http://localhost:3100
# Produccion: https://api.tudominio.com
API_URL=http://localhost:3100

# Misma clave que WHATSAPP_INTEGRATION_API_KEY en el .env de la API.
# Esta PC no tiene credenciales de MariaDB: solo esta clave.
WHATSAPP_INTEGRATION_API_KEY=cambiar_por_clave_aleatoria

# Puerto local del servidor de WPConnect.
WPPCONNECT_PORT=21465

# Cada cuanto consultar la API las notificaciones pendientes (ms).
POLL_INTERVAL_MS=60000

# Donde guardar el QR al escanear. Vacio = whatsapp/qr_gnv.png
QR_PATH=

# IA local de conversacion (Ollama). Opcional.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=vcgas-bot
